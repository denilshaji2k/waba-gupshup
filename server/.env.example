# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/waba-bsp
MONGODB_USER=admin
MONGODB_PASS=password123

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# Gupshup API Configuration
GUPSHUP_API_KEY=your_gupshup_api_key_here
GUPSHUP_APP_ID=your_gupshup_app_id_here
GUPSHUP_BASE_URL=https://api.gupshup.io/wa

# Webhook Configuration
WEBHOOK_URL=https://yourdomain.com/api/webhooks/message
WEBHOOK_TOKEN=your_webhook_security_token

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
SENDER_EMAIL=noreply@wababsp.com

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGIN=http://localhost:3000

# Session
SESSION_SECRET=your_session_secret_key

# Analytics
ENABLE_ANALYTICS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
